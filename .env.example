# KOT/BILL printing: who may send to the kitchen printer directly.
# AGENT_ONLY = only the on-site Terra Admin app prints (recommended for production).
# BACKEND_ALLOWED = backend may also send to printer via network (e.g. same LAN).
PRINT_MODE=AGENT_ONLY

# Firebase Admin (individual service-account fields)
# Keep FIREBASE_PRIVATE_KEY with escaped \n in one line.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=

# Optional debug tracing (enable only when diagnosing realtime/notification issues)
BACKEND_ENABLE_NOTIFICATION_DEBUG=false
BACKEND_ENABLE_SOCKET_TRACE=false

# OpenAI (Voice Inventory + Translation + Voice Order)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis (Socket.IO adapter + translation cache + AI usage counters + voice parse cache)
REDIS_URL=redis://default:gQAAAAAAAYFYAAIgcDE0ZTU0MGI1YmFmZWU0MzViYmE4NTk2Yjc0Nzk0MzVjMg@busy-buck-98648.upstash.io:6379

# Voice tap-to-order: Top-K menu retrieval before GPT (disable with VOICE_RETRIEVAL_V2=false)
VOICE_RETRIEVAL_V2=true
VOICE_MENU_TOP_K=40
VOICE_PARSE_CACHE_ENABLED=true
VOICE_PARSE_CACHE_TTL_SEC=1800

# Translation: Redis persistence (disable with TRANSLATION_REDIS_ENABLED=false)
TRANSLATION_REDIS_ENABLED=true

# AI session tokens for customer web (HMAC; defaults JWT_SECRET if unset)
AI_SESSION_SECRET=
AI_SESSION_TTL_MS=86400000
# When true, anonymous clients cannot call AI routes without x-terra-ai-session
AI_REQUIRE_CUSTOMER_SESSION=false

# Tracking / limits
AI_USAGE_TRACKING_ENABLED=true
RATE_LIMIT_AI_VOICE_PER_MIN=30
RATE_LIMIT_AI_TRANSLATE_PER_MIN=20
RATE_LIMIT_AI_SESSION_PER_MIN=30

# Redis-backed fixed-window counters for aiVoice / aiTranslate / aiSessionIssue (falls back to memory if REDIS_URL unset or error)
REDIS_RATE_LIMIT_ENABLED=true
# When true, AI rate-limit key includes req.aiCartId (requires auth middleware to set aiCartId)
REDIS_RL_PER_AI_CART=false

# Voice parse single-flight (after Redis cache miss)
VOICE_PARSE_LOCK_TTL_SEC=45
VOICE_PARSE_COALESCE_WAIT_MS=20000

# Stability rollout flags (A->J phased; rollback-safe defaults)
ENABLE_NO_RELOAD_RECOVERY=true
ENABLE_SOCKET_ROOM_JOIN_DEDUPE=true
ENABLE_EVENT_ACK_GUARD=true
ENABLE_EVENT_ORIGIN_METADATA=true
ENABLE_SOCKET_DEDUPE=true
ENABLE_REQUEST_DEDUPE=true
ENABLE_POLLING_MUTEX=true
ENABLE_SINGLETON_SOCKET_ADMIN=true
ENABLE_SINGLETON_SOCKET_CUSTOMER=true
ENABLE_SINGLETON_SOCKET_FLUTTER=true
ENABLE_CANONICAL_EVENTS=true
ENABLE_LEGACY_EVENT_COMPAT=true
ENABLE_ROOM_ONLY_EMITS=false
ENABLE_VISIBILITY_POLLING_PAUSE=true
ENABLE_INDEXEDSTACK_TAB_PAUSE=true
ENABLE_SINGLE_PRINT_LEADER=false
ENABLE_PRINT_LEASE_HEARTBEAT=false
ENABLE_PRINT_FAILSAFE_POLLING=true
ENABLE_SOCKET_BACKOFF_JITTER=true
ENABLE_SOCKET_BURST_PROTECTION=false
ENABLE_STABILITY_OBSERVABILITY=true

# Stability thresholds
MAX_ROOM_JOINS_PER_MINUTE=120
MAX_RECONNECTS_PER_MINUTE=60
MAX_EVENT_BURST_PER_SECOND=25
MAX_API_CALLS_PER_MINUTE_PER_KEY=120
MAX_RECONNECT_ATTEMPTS_PER_WINDOW=12
RECONNECT_FAILURE_WINDOW_MS=120000
RECONNECT_COOLDOWN_MS=30000
SOCKET_RECONNECT_MAX_ATTEMPTS=40
