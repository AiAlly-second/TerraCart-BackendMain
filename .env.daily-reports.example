RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@terracart.in
RESEND_FROM_NAME=TerraCart
REPORT_TIMEZONE=Asia/Kolkata
RESEND_WEBHOOK_SECRET=
# HTTPS URL of the existing TerraCart brand logo (optional; text branding is the fallback).
DAILY_REPORT_LOGO_URL=
